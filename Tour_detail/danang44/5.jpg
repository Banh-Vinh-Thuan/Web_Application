<script>
    var googleUser = {};
    var startSigninModal = function () {
        gapi.load('auth2', function () {
            auth2 = gapi.auth2.init({
                client_id: '330238844674-ebol2ncpau9556lqqvhiaopp3gs87pl8.apps.googleusercontent.com',
                plugin_name: 'chat',
                cookiepolicy: 'single_host_origin',
                scope: 'profile',
                prompt: 'select_account',
            });
            signinHandleClick(document.getElementById('btnAddToCard_1'), "AddToCart", 0);
            signinHandleClick(document.getElementById('btnPrepareToPay_1'), "PrepareToPay", 0);
            signinHandleClick(document.getElementById('btnAddToCard_2'), "AddToCart", 0);
            signinHandleClick(document.getElementById('btnPrepareToPay_2'), "PrepareToPay", 0);
        });
    };
    function signinHandleClick(element, clickMode, type) {
        auth2.attachClickHandler(element, {},
            function (googleUser) {
                app.postData('/Home/TicketLoginGoogle',
                    {
                        //id: googleUser.Zx.u8,
                        //email: googleUser.Zx.Wy,
                        //name: googleUser.Zx.kh,
                        //given_name: googleUser.Zx.R9,
                        //family_name: googleUser.Zx.Y7,
                        //picture: googleUser.Zx.TU,
                        verified_email: true,
                        access_token: googleUser.Kc.access_token,
                        id_token: googleUser.Kc.id_token,
                        ticket_id: ticket.Id,
                    },
                    function (result) {
                        if (result.Success) {
                            var customer = result.Data;
                            //console.log(customer, 'customer');
                            //debugger
                            switch (clickMode) {
                                case "AddToCart":
                                    {
                                        var data = {};
                                        switch (type) {
                                            case 0: {
                                                if (!f1.hasError()) {
                                                    var t = f1.getFormData();
                                                    t = app.formDataToJson(t);
                                                    data = t;
                                                    if (t.NgayKhoiHanh == '') {
                                                        app.notify('warning', getLabel('CanhBaoChonNgayKhoiHanh'));
                                                        setTimeout(function () { location.reload(); }, 2000);
                                                        return false;
                                                    }
                                                } else {
                                                    return false;
                                                }
                                            } break;
                                            case 1: {
                                                if (!f2.hasError()) {
                                                    var t = f2.getFormData();
                                                    t = app.formDataToJson(t);
                                                    data = t;
                                                } else {
                                                    return false;
                                                }
                                            } break;
                                        }
                                        data.TicketId = ticket.Id;
                                        data.tourType = type;
                                        data.CustomerId = customer.Id;
                                        //console.log(data, 'data');
                                        //debugger
                                        app.postData('/order/addOrderCart', data, function (result) {
                                            if (result.Success) {
                                                //console.log(result, 'orderCart');
                                                //debugger;
                                                app.notify("success", 'Add to cart success');
                                                setTimeout(location.reload(), 2000);
                                            }
                                        })

                                    }; break;
                                case "PrepareToPay":
                                    {
                                        var data = {
                                            tickets: []
                                        };
                                        switch (type) {
                                            case 0: {
                                                if (!f1.hasError()) {
                                                    var t = f1.getFormData();
                                                    t = app.formDataToJson(t);
                                                    if (t.NgayKhoiHanh == '') {
                                                        app.notify('warning', getLabel('CanhBaoChonNgayKhoiHanh'));
                                                        setTimeout(function () { location.reload(); }, 2000);
                                                        return false;
                                                    }
                                                } else {
                                                    return false;
                                                }
                                            } break;
                                            case 1: {
                                                if (!f2.hasError()) {
                                                    var t = f2.getFormData();
                                                    t = app.formDataToJson(t);
                                                } else {
                                                    return false;
                                                }
                                            } break;
                                        }

                                        t.ticketId = ticket.Id;
                                        t.tourType = type;
                                        t.CustomerId = customer.Id;
                                        data.tickets.push(t);
                                        data.OrderType = type;

                                        //console.log(data, 'data');
                                        //debugger

                                        app.postData('/order/CreateOrder', data, function (result) {
                                            window.location.href = '/order/PrepareToPay/' + result.Data.Id;
                                        })
                                    }; break;
                            }
                        }
                        else { location.reload(); }
                    });
            }, function (error) {
                console.log(JSON.stringify(error, undefined, 2));
            });
    }
</script>


