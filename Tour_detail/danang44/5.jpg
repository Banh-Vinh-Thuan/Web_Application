<script src="/assets/release/lightgallery/lightgallery.js?v=030920251035" type="text/javascript"></script><link rel="stylesheet" href="/assets/release/lightgallery/lightgallery.css?v=030920251035" />
<script>
    $(document).ready(function () {
        $('.btn-submit').click(function (e) {
            e.preventDefault(); // Ngăn chặn form gửi đi theo cách mặc định

            // Lấy dữ liệu từ form
            var name = $('[name="Name"]').val();
            var email = $('[name="Email"]').val();
            var dienThoai = $('[name="DienThoai"]').val();
            var noiDung = $('[name="NoiDung"]').val();

            // Gửi dữ liệu đến server (ví dụ sử dụng AJAX)
            $.ajax({
                url: '/duong-dan-den-api-cua-ban', // Thay đổi đường dẫn này
                type: 'POST',
                data: {
                    Name: name,
                    Email: email,
                    DienThoai: dienThoai,
                    NoiDung: noiDung
                },
                success: function (response) {
                    // Xử lý khi gửi thành công (ví dụ: hiển thị thông báo)
                    alert('Gửi thông tin thành công!');
                    $('#callbackModal').modal('hide'); // Ẩn modal sau khi gửi
                },
                error: function (error) {
                    // Xử lý khi có lỗi
                    alert('Có lỗi xảy ra khi gửi thông tin.');
                }
            });
        });
    })
</script>
