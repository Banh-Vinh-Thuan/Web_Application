                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Chọn ngày khởi hành</h4>
            </div>
            <div class="modal-body">
                <div class="loading" style="display: none">
                    <div>
                        <div class="sk-chase">
                            <div class="sk-chase-dot"></div><div class="sk-chase-dot"></div>
                            <div class="sk-chase-dot"></div><div class="sk-chase-dot"></div>
                            <div class="sk-chase-dot"></div><div class="sk-chase-dot"></div>
                        </div>
                    </div>
                </div>
                <div class="btn-group btn-group-fade mb-15">
                    <button type="button" class="btn border-slate btn-daterangepicker btn-default btn-rounded "
                            style="width: 240px; text-align: left">
                        <i class="icon-calendar2 mr-5 no-margin"></i>
                        <span>Ngày khởi hành</span>
                        <i class="icon-arrow-down12 pull-right  " style="margin-top: 5px"></i>
                    </button>
                </div>
                <div class="table-responsive" style="max-height: 600px;">
                    <table class="table table-bordered table-xs table-price" style="width: 100%; max-width: unset">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 100px;" rowspan="2">Ngày <br />khởi hành</th>
                                <th class="text-center" rowspan="2">Tour code</th>
                                <th class="text-center" colspan="3">Giá tiền</th>
                                <th class="text-center" rowspan="2">Giảm giá</th>
                                
                                <th class="text-center" style="width: 100px" rowspan="2"></th>
                            </tr>
                            <tr>
                                <th class="text-center">Người lớn</th>
                                <th class="text-center">Trẻ em</th>
                                <th class="text-center">Em bé</th>

                            </tr>
                        </thead>
                        <tbody data-bind="foreach: priceGroup">
                            <tr data-bind="visible: InFilterDate() == true">
                                <td data-bind="text: ngayKhoiHanhStr"></td>

                                <td data-bind="text: tourCode"></td>
                                <td data-bind="text: donGiaStr" class="text-right"></td>
                                <td data-bind="text: donGiaTreEmStr" class="text-right"></td>
                                <td data-bind="text: donGiaEmBeStr" class="text-right"></td>

                                <td class="text-right" data-bind="css: { 'saleoff' : TyLeGiam() > 0 }">
                                    <span data-bind="text: giamGia_Str"></span>
                                    <img src="/assets/file/1374072.png" />
                                </td>

                                

                                <td>
                                    <button data-bind="click: $root.SelectPrice, enable: Valid" style="width: 100px" class="btn btn-rounded btn-warning btn-md btn-select-price" type="button">
                                        Chọn
                                    </button>
                                    
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
