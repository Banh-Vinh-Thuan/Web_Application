	function initSearchCbEmpModal(id, callback) {
		var scbum = 'searchCbEmpModal';
		app.createPartialModal({
			url: '/base/GetPartialView',
			data: {
				module: 'general',
				partialName: 'SearchCbUserModal'
			},
			modal: {
				width: '80%',
				id: scbum,
				title: 'Tra cứu thông tin nhân sự',
				noPaddingBody: true
			}
		}, function () {
			setTimeout(function () {
				initSearchCbEmpForm(id);
			}, 500);
			callback();
		});
	}

	$(document).ready(function () {
		$('.btn-search-cb-emp').click(function () {
			var btn = $(this);
			btn.button('loading');
			initSearchCbEmpModal(null,
				function () {
					btn.button('reset');
				});
		});


		$('#project_selector').select2({}).change(function (v) {
			console.log(v.val);

			window.location.href = '/project/index?projectid=' + v.val;
		});

		$('#search-control-header').searchHeaderTicket({

		});

		$(".nav-tabs-vertical > ul > li").hover(function () {
			$(".nav-tabs-vertical > ul > li").removeClass('active');
			$('.nav-tabs-vertical .tab-content .tab-pane').removeClass('active');
			$(this).addClass("active");
			var selected_tab = $(this).find("a").attr("href");
			$(selected_tab).addClass("active");
			return false;
		});


		$('.btn-change-area').click(function () {
			var v = $(this).attr('data-v');
			var btn = $(this);
			btn.button('loading');

			app.postData('/base/ChangeKVKH', {
				value: v
			}, function (result) {
				location.reload();
			});
		});
	});
</script>


